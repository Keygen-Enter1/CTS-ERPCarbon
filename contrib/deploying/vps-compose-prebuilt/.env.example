###############################################################################
# Carbon VPS Compose — public config (copy to .env on the server).
# Secrets live in ./secrets/* (see init-secrets.sh). Never commit .env or secrets/.
###############################################################################

# Absolute path to this git checkout on the VPS (for Caddy, Kong, edge functions, Postgres init).
CARBON_REPO=/opt/carbon

# ── Hostnames (DNS A/AAAA → this VPS) ───────────────────────────────────────
DOMAIN=example.com
ERP_HOST=erp.example.com
MES_HOST=mes.example.com
SUPABASE_HOST=api.example.com
STUDIO_HOST=

ERP_URL=https://erp.example.com
MES_URL=https://mes.example.com
SUPABASE_URL=https://api.example.com
ACME_EMAIL=admin@example.com

# ── Prebuilt images (built locally, pushed to your registry) ─────────────────
# Example: registry.example.com/yourorg/carbon/erp:1.0.0
CARBON_IMAGE_ERP=registry.example.com/yourorg/carbon/erp:latest
CARBON_IMAGE_MES=registry.example.com/yourorg/carbon/mes:latest
CARBON_IMAGE_BOOTSTRAP=registry.example.com/yourorg/carbon/bootstrap:latest

# ── App ─────────────────────────────────────────────────────────────────────
CARBON_EDITION=community
AUTH_PROVIDERS=email,google,azure
SMTP_FROM="Carbon <no-reply@example.com>"

GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com
GOTRUE_SMTP_SENDER_NAME=Carbon
GOTRUE_DISABLE_SIGNUP=true

GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=https://api.example.com/auth/v1/callback
AZURE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_REDIRECT_URI=https://api.example.com/auth/v1/callback

STUDIO_REPLICAS=1
PG_MEMORY_LIMIT=2048M
PG_MAX_CONNECTIONS=100
