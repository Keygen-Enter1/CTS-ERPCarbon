###############################################################################
# SmartSite VPS — copy to ../../.env (do not commit .env).
#
#   cd contrib/deploying/vps-compose-prebuilt
#   cp environments/smartsite/env.template .env
#   nano .env
#   bash ./init-secrets.sh
#
# Stack:  docker compose -f docker-compose.smartsite.yml up -d --scale caddy=0
###############################################################################

# Git checkout on this server (bind-mounts for Kong, Postgres init, secrets shim).
CARBON_REPO=/home/abinh/CTS-ERPCarbon

# ── Public URLs (HTTP on host ports 30xxx — must match docker-compose.publish-30xxx.yml)
# Browser + magic-link redirects. Do NOT use https://…:443 unless nginx TLS is configured.
ERP_URL=http://erpcarbon.smartsite.vn:30000
MES_URL=http://mescarbon.smartsite.vn:30001
SUPABASE_URL=http://apicarbon.smartsite.vn:30003

# Host labels (DNS A → this VPS)
DOMAIN=
ERP_HOST=erpcarbon.smartsite.vn
MES_HOST=mescarbon.smartsite.vn
SUPABASE_HOST=apicarbon.smartsite.vn

# DOMAIN: leave empty for HTTP :30000 so session cookies work (no Secure cookie on plain HTTP).
# Set DOMAIN=smartsite.vn only when ERP/MES/API are served over HTTPS on :443.

ACME_EMAIL=admin@smartsite.vn

# Server-side Supabase + Inngest (Docker network). Set in docker-compose.yml for erp/mes;
# listed here for reference — you do not need SUPABASE_INTERNAL_URL in .env if compose is current.
# SUPABASE_INTERNAL_URL=http://kong:8000

INNGEST_EVENT_API_BASE_URL=http://inngest:8288/
INNGEST_SERVE_HOST=http://erpcarbon.smartsite.vn:30000

# ── Images (build on server: TAG=smartsite-1 bash ./build-on-server.sh)
CARBON_IMAGE_ERP=carbon/erp:smartsite-1
CARBON_IMAGE_MES=carbon/mes:smartsite-1
CARBON_IMAGE_BOOTSTRAP=carbon/bootstrap:smartsite-1
SKIP_PULL=1

SCALE_CADDY=0

# ── App ─────────────────────────────────────────────────────────────────────
CARBON_EDITION=community
AUTH_PROVIDERS=email

# Login / verify: max POST attempts per IP per hour (Redis). Default 5 — easy to hit while testing VPS.
RATE_LIMIT=30

# First user: set false until an admin exists, then true to lock public signup.
GOTRUE_DISABLE_SIGNUP=false

# Optional: create first auth user on `pnpm db:seed` (no company). Prefer signup + onboarding or db:seed:dev.
# ADMIN_EMAIL=admin@smartsite.vn

# ── Email (Gmail App Password — NOT your login password) ────────────────────
# Used by ERP (verify code) AND GoTrue (magic link for existing users). Same secret file.
# Password file: secrets/smtp_password (16 chars, no spaces/newline). Never put SMTP_PASS in .env.
SMTP_FROM="Carbon SmartSite <YOUR_GMAIL@gmail.com>"
GOTRUE_SMTP_HOST=smtp.gmail.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=YOUR_GMAIL@gmail.com
GOTRUE_SMTP_ADMIN_EMAIL=YOUR_GMAIL@gmail.com
GOTRUE_SMTP_SENDER_NAME=Carbon ERP

GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=http://apicarbon.smartsite.vn:30003/auth/v1/callback
AZURE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_REDIRECT_URI=http://apicarbon.smartsite.vn:30003/auth/v1/callback

STUDIO_REPLICAS=0
PG_MEMORY_LIMIT=2048M
PG_MAX_CONNECTIONS=100

# ── Firewall (inbound): TCP 30000 ERP, 30001 MES, 30003 API
# Outbound 587 (smtp.gmail.com) for mail. Postgres/Redis are internal only.

# ── Secrets (files under ./secrets/, not in .env) ───────────────────────────
# postgres_password, jwt_secret, anon_key, service_role_key, session_secret,
# inngest_signing_key, inngest_event_key, smtp_password, postgrest_db_uri
