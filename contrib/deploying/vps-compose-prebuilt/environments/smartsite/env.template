###############################################################################
# SmartSite production — copy to ../../.env on the VPS (do not commit .env).
#
#   cp environments/smartsite/env.template ../../.env
###############################################################################

CARBON_REPO=/opt/carbon

# ── SmartSite domains ───────────────────────────────────────────────────────
DOMAIN=smartsite.vn
ERP_HOST=erpcarbon.smartsite.vn
MES_HOST=mescarbon.smartsite.vn
SUPABASE_HOST=apicarbon.smartsite.vn

# Public HTTP on host ports (docker-compose.publish-30xxx.yml)
ERP_URL=http://erpcarbon.smartsite.vn:30000
MES_URL=http://mescarbon.smartsite.vn:30001
# Public API URL (browser). ERP/MES server calls use SUPABASE_INTERNAL_URL=http://kong:8000 in compose.
SUPABASE_URL=http://apicarbon.smartsite.vn:30003

INNGEST_EVENT_API_BASE_URL=http://inngest:8288/
INNGEST_SERVE_HOST=http://erpcarbon.smartsite.vn:30000

ACME_EMAIL=admin@smartsite.vn

# ── Host ports (docker-compose.publish-30xxx.yml) ───────────────────────────
# 30000 → ERP   http://erpcarbon.smartsite.vn:30000/
# 30001 → MES   http://mescarbon.smartsite.vn:30001/
# 30003 → Kong  http://apicarbon.smartsite.vn:30003/

# ── Prebuilt images (from local build-and-push) ─────────────────────────────
CARBON_IMAGE_ERP=REPLACE_REGISTRY/carbon/erp:REPLACE_TAG
CARBON_IMAGE_MES=REPLACE_REGISTRY/carbon/mes:REPLACE_TAG
CARBON_IMAGE_BOOTSTRAP=REPLACE_REGISTRY/carbon/bootstrap:REPLACE_TAG

# ── App ─────────────────────────────────────────────────────────────────────
CARBON_EDITION=community
AUTH_PROVIDERS=email,google,azure
# From-address (Gmail: use the same mailbox as GOTRUE_SMTP_USER or a verified alias)
SMTP_FROM="Carbon SmartSite <smartsitects@gmail.com>"

# SMTP — ERP verification codes + GoTrue magic links (password → secrets/smtp_password, not here)
GOTRUE_SMTP_HOST=smtp.gmail.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=smartsitects@gmail.com
GOTRUE_SMTP_ADMIN_EMAIL=smartsitects@gmail.com
GOTRUE_SMTP_SENDER_NAME=Carbon ERP
GOTRUE_DISABLE_SIGNUP=true

GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=http://apicarbon.smartsite.vn:30003/auth/v1/callback
AZURE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_REDIRECT_URI=http://apicarbon.smartsite.vn:30003/auth/v1/callback

STUDIO_REPLICAS=0
PG_MEMORY_LIMIT=2048M
PG_MAX_CONNECTIONS=100
